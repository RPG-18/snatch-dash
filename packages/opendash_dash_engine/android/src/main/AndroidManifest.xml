<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  package="com.opendash.opendash_dash_engine">

  <!-- DashWifiManager reads ConnectivityManager.getNetworkCapabilities on every signal
       sample and on SSID resolution, which the platform gates on this permission. The app
       module declares it too, but a library that needs a permission has to say so itself:
       merged into whatever app embeds this plugin, it is what keeps those calls legal
       there as well. Android Lint reported the omission as two MissingPermission errors. -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

  <!-- Only to ASK. `ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS` shows the system dialog
       and refuses to open without this declared; nothing here exempts the app by itself,
       and the rider can revoke it in Settings at any time.

       Google's policy allows this prompt for a "peripheral device companion" — an app
       whose job is to keep talking to hardware the user is wearing or riding — which is
       exactly this one: the dash is fed with the phone's screen off, and Doze stopping
       the foreground service stops the map mid-ride. Declared in the plugin rather than
       the app because the code that asks lives here. -->
  <uses-permission
    android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
    tools:ignore="BatteryLife" />

  <!-- So `resolveActivity` can see who handles the prompt. Under targetSdk 30+ package
       visibility, an app sees only force-queryable packages unless it declares otherwise;
       `com.android.settings` is force-queryable, but on skins where an OEM package owns
       this screen the lookup returns null. The button then hides itself and the rider is
       told to find the setting by hand — on a phone where tapping it would have worked.
       Android Lint names this `QueryPermissionsNeeded` on the `resolveActivity` call. -->
  <queries>
    <intent>
      <action android:name="android.settings.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
      <!-- The scheme is not decoration. AOSP's filter declares
           `<data android:scheme="package"/>`, and visibility matching runs ordinary
           intent resolution: a query with no URI only matches a filter with no data
           element, so without this the block matches nothing and grants nothing. -->
      <data android:scheme="package" />
    </intent>
  </queries>
</manifest>
