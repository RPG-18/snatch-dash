/maptiler_proxy.conf

# Decompiled reference app (not part of this project's source)
/re_app/

# Local notes: checked-but-not-done ideas, kept next to the code rather than in
# the repo — they are a working surface, not documentation.
/todo-check.md

# Стендовая инструкция под конкретную правку — живёт рядом с кодом, но не в
# истории: она устаревает в тот день, когда проверка пройдена.
/bench-check.md

# Отчёт по сессии — снимок состояния на один день, который назавтра
# расходится с кодом. Выводы из него переезжают в network-refactoring.md,
# сам файл в историю не идёт.
/report.md
